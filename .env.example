# Copy to .env and fill in. Never commit the real .env file.

# PostgreSQL connection string (Neon, Supabase, RDS, or self-hosted).
# This is what the running app uses for every query — point it at a
# pooled connection string if your provider offers one (Neon/Supabase's
# pooled port, PgBouncer, Vercel Postgres): serverless functions open a
# lot of short-lived connections and a pooler prevents exhausting Postgres'
# own connection limit.
# Example (pooled):   postgresql://user:password@host-pooler:5432/finloraq?sslmode=require&pgbouncer=true
DATABASE_URL=

# Required. Used only by `prisma migrate`/`prisma db seed`, never by the
# running app. Must be a DIRECT (non-pooled) connection — migrations run
# advisory locks and DDL that a pooler like PgBouncer can break. If
# DATABASE_URL above is already a direct connection (self-hosted Postgres/
# RDS with no pooler), set DIRECT_URL to the exact same value.
# Example (direct):   postgresql://user:password@host:5432/finloraq?sslmode=require
DIRECT_URL=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Redis (background jobs — bank import processing, forecasts, AI usage
# metering). Optional for local dev of core CRUD flows; required once
# Phase 4+ background jobs are wired in.
REDIS_URL=

# Object storage for uploaded documents (Phase 6). Use any S3-compatible
# provider (S3, R2, Backblaze B2, Supabase Storage).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# AI provider (Phase 6 — AI Copilot / document extraction). The AI
# abstraction layer (src/lib/ai/) is provider-agnostic; set whichever
# provider's key you're using.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Billing provider (Phase 8). Leave blank until subscriptions go live —
# the Subscription model works without one (plan defaults to STARTER/
# TRIALING).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business API (Phase 7).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Inbound email for invoice/receipt ingestion (Phase 7), e.g. a provider
# like Postmark/Mailgun inbound webhook secret.
INBOUND_EMAIL_WEBHOOK_SECRET=
