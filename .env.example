# Copy to .env and fill in. Never commit the real .env file.

# PostgreSQL connection string (Neon, Supabase, RDS, Prisma Postgres, or
# self-hosted). This is what both the running app and `prisma migrate` use.
# If your provider is a classic Neon/Supabase-style pooler, point this at
# the pooled connection string and add a `directUrl` back to
# prisma/schema.prisma pointed at the provider's real direct connection
# string (verify its exact shape against a deploy log — providers differ,
# and Prisma Postgres in particular has no conventional postgres:// direct
# connection at all, so directUrl doesn't apply there).
# Example: postgresql://user:password@host:5432/finloraq?sslmode=require
DATABASE_URL=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Redis (background jobs — bank import processing, forecasts, AI usage
# metering). Optional for local dev of core CRUD flows; required once
# Phase 4+ background jobs are wired in.
REDIS_URL=

# Object storage for uploaded documents (Phase 6). Use any S3-compatible
# provider (S3, R2, Backblaze B2, Supabase Storage).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# AI provider (Phase 6 — AI Copilot / document extraction). The AI
# abstraction layer (src/lib/ai/) is provider-agnostic; set whichever
# provider's key you're using.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe billing (Phase 8). Leave blank for simulated billing. Use
# sk_test_… first; see DEPLOYMENT.md section 3b. The webhook secret is the
# endpoint's signing secret (whsec_…) for /api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" only after adding your UAE VAT registration in Stripe
# (Dashboard → Tax → Registrations). Prices are VAT-inclusive either way.
STRIPE_AUTOMATIC_TAX=
# Optional. Lets each company connect its own Stripe account so its customers
# can pay invoices by card ("Get payment link" on a sent invoice). Uses the same
# STRIPE_SECRET_KEY. Add a SECOND Stripe webhook endpoint listening to
# "Connected accounts" events at /api/webhooks/stripe-connect and put its
# signing secret (whsec_...) here.
STRIPE_CONNECT_WEBHOOK_SECRET=

# WhatsApp Business API (Phase 7).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Inbound email for invoice/receipt ingestion (Phase 7), e.g. a provider
# like Postmark/Mailgun inbound webhook secret.
INBOUND_EMAIL_WEBHOOK_SECRET=

# Public domain. Set both only after the domain resolves to Vercel with HTTPS:
#   NEXTAUTH_URL=https://finloraq.com
#   CANONICAL_HOST=finloraq.com   (redirects finloraq-app.vercel.app → finloraq.com)
CANONICAL_HOST=

# Optional. A webhook URL (e.g. a Slack "Incoming Webhook" from an existing
# workspace) that gets a POST whenever src/lib/monitoring.ts's
# captureException() runs — i.e. whenever the app's error boundaries
# (src/app/error.tsx, global-error.tsx) catch something. Every error is
# already logged to Vercel's own Runtime Logs regardless of this being set;
# this just adds a live push notification. Leave blank to skip that.
MONITORING_WEBHOOK_URL=

# Sign in with Google (optional). Create an OAuth 2.0 Web client in Google
# Cloud Console and add this authorised redirect URI:
#   ${NEXTAUTH_URL}/api/auth/callback/google
# The "Continue with Google" button stays hidden until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email confirmation for new email+password sign-ups. Confirmation emails are
# sent through Resend, so RESEND_API_KEY and EMAIL_FROM must be set. Once email
# is configured, accounts created from 2026-09-28 must confirm before their
# first sign-in. Set to "true" to force it on, "false" to switch it off.
REQUIRE_EMAIL_VERIFICATION=

# Shared secret for the Vercel Cron-triggered routes (src/app/api/cron/*).
# Generate with: openssl rand -base64 32
# Required in production — without it, /api/cron/* returns 501 rather than
# running unauthenticated (see vercel.json for the scheduled paths).
CRON_SECRET=
