// Finloraq — Prisma schema
// Phase 1 (foundation, auth, multi-tenancy, RBAC, company setup) is fully modeled.
// Phase 2+ accounting tables are included as the ledger skeleton so later phases
// attach without a schema rewrite, but their write-paths are not implemented yet —
// see /src/lib/ledger.ts for the posting-engine stub and TODOs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // No directUrl here on purpose. It's the right move for a classic pooled
  // setup (Neon/Supabase's pooled port needs a separate direct connection
  // for migrations) but this project runs on Prisma Postgres (provisioned
  // through the Vercel Marketplace), which is Accelerate-only — DATABASE_URL
  // itself is what `prisma migrate deploy` uses, and there's no conventional
  // postgres:// direct connection string to point directUrl at. A prior
  // revision of this file added directUrl pointed at POSTGRES_URL, assuming
  // a Neon/Supabase-style pooler; that broke every deploy with "P1013: the
  // scheme is not recognized" because Prisma Postgres' connection strings
  // don't take that shape. If this project ever moves to a provider that
  // does need the pooled/direct split, add directUrl back and point it at
  // that provider's real direct connection string — verify against an
  // actual deploy log before assuming the shape, not from general advice.
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY, TENANCY, RBAC
// ─────────────────────────────────────────────────────────────────────────

enum GlobalRole {
  SUPER_ADMIN // Finloraq platform operator, not a company member
  USER
}

/// A person who can sign in. A single User can belong to multiple Companies
/// (accountants / multi-company staff) via CompanyMembership.
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String
  // Profile photo, personal to this user (not the company's branding —
  // see Company.logoUrl for that). Stored as a data: URL, same reasoning
  // as Company.logoUrl below: no object storage is configured yet, and a
  // small avatar is cheap enough to keep inline. Editable by the user
  // themselves regardless of company role — see /api/profile/photo.
  avatarUrl     String?
  passwordHash  String
  globalRole    GlobalRole @default(USER)
  mfaEnabled    Boolean    @default(false)
  mfaSecret     String? // base32 TOTP secret; never returned via any API response.
  /// When a user first holds a role that requires MFA (Company Admin / CFO) without it, the
  /// grace deadline to enroll is set here — see src/lib/mfaPolicy.ts. Never a lockout.
  mfaGraceUntil DateTime?
  // "Encrypted at rest" here relies on the database provider's disk
  // encryption (standard on RDS/Neon/Supabase) — it is NOT application-
  // level encrypted before storage. Unlike a password, a TOTP secret
  // must be readable in plaintext to verify a code (HMAC needs the raw
  // key), so hashing isn't an option here the way it is for passwords/
  // backup codes; envelope-encrypting this column with a KMS key before
  // insert is the real hardening step, left as a TODO for production.
  isActive      Boolean    @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships CompanyMembership[]
  auditEvents AuditEvent[]
  sessions    Session[]
  approvals   Approval[]
  backupCodes MfaBackupCode[]
  preference  UserPreference?

  @@index([email])
}

/// One-time MFA recovery codes (spec section 21's MFA requirement). Only
/// a salted hash is ever stored — same reasoning as passwords — so a DB
/// read alone can never yield a usable code. Each row is consumed once
/// (usedAt set) rather than deleted, so "a used code was used" stays
/// auditable.
model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// NextAuth session table (database session strategy — safer than JWT-only
/// for a finance product: sessions are revocable server-side).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Tenant root. Every business-data row hangs off a Company (or a Branch
/// that belongs to one), which is how tenant isolation is enforced —
/// every query in /src/lib/db.ts's scoped client is filtered by companyId.
model Company {
  id            String   @id @default(cuid())
  name          String
  legalName     String?
  countryCode   String // ISO 3166-1 alpha-2, drives the active TaxPack
  baseCurrency  String // ISO 4217, e.g. "AED"
  timezone      String   @default("Asia/Dubai")
  fiscalYearEnd Int      @default(12) // month 1-12
  taxRegNumber  String? // e.g. UAE TRN
  // Branding — available on every plan (no feature gate, unlike
  // documentExtraction/eInvoicing/etc. in src/lib/billing/plans.ts).
  // Applied to the header of customer-facing documents (currently the
  // Invoice detail page; the same fields are ready for quotations,
  // receipts and statements once those exist as their own features).
  // logoUrl is a data: URL for the same no-object-storage-yet reason as
  // User.avatarUrl above — see /api/settings/branding for the size cap.
  logoUrl       String?
  tagline       String?
  brandEmail    String?
  brandPhone    String?
  brandAddress  String?
  isDemo        Boolean  @default(false)
  /// Customisation (admins, Settings → Branding / Menu). The logo itself is logoUrl above.
  brandColor    String?
  invoiceFooter String?
  invoiceTerms  String?
  /// Company-wide sidebar layout: { order: string[], hidden: string[] } (hrefs).
  navConfig     Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships            CompanyMembership[]
  branches               Branch[]
  departments            Department[]
  costCentres            CostCentre[]
  accounts               Account[]
  accountingPeriods      AccountingPeriod[]
  journalEntries         JournalEntry[]
  customers              Customer[]
  suppliers              Supplier[]
  invoices               Invoice[]
  bills                  Bill[]
  bankAccounts           BankAccount[]
  taxCodes               TaxCode[]
  apiKeys                ApiKey[]
  products               Product[]
  projects               Project[]
  documents              Document[]
  auditEvents            AuditEvent[]
  workflowRules          WorkflowRule[]
  paymentConnection      PaymentConnection?
  onlinePayments         OnlinePayment[]
  customFieldDefinitions CustomFieldDefinition[]
  subscription           Subscription?
  invitations            Invitation[]
  memberFiles            MemberFile[]
  // CRM back-relations
  pipelines              Pipeline[]
  leads                  Lead[]
  crmContacts            CrmContact[]
  deals                  Deal[]
  crmActivities          CrmActivity[]
  // P1 additions
  recurringInvoices      RecurringInvoice[]
  budgets                Budget[]
  quotes                 Quote[]
  purchaseOrders         PurchaseOrder[]
  creditNotes            CreditNote[]
  salesOrders            SalesOrder[]
  shipments              Shipment[]
  purchaseReceives       PurchaseReceive[]

  @@index([countryCode])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, code])
}

model CostCentre {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, code])
}

enum CompanyRole {
  COMPANY_ADMIN
  CFO
  FINANCE_MANAGER
  ACCOUNTANT
  STAFF
  AUDITOR
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  APPROVE
  DELETE
  EXPORT
}

/// Join table: which users belong to which company, with which role.
/// This — not the User row — is what request-time authorization checks.
model CompanyMembership {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  company                  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  overrides                PermissionOverride[]
  apiKeys                  ApiKey[]
  dashboardLayout          DashboardLayout?
  files                    MemberFile[]
  // CRM back-relations
  assignedLeads            Lead[]               @relation("LeadAssignedTo")
  createdLeads             Lead[]               @relation("LeadCreatedBy")
  assignedDeals            Deal[]               @relation("DealAssignedTo")
  assignedActivities       CrmActivity[]        @relation("ActivityAssignedTo")
  createdActivities        CrmActivity[]        @relation("ActivityCreatedBy")
  createdRecurringInvoices RecurringInvoice[]

  @@unique([companyId, userId])
  @@index([userId])
}

/// A file an admin attaches to a member's record on the Users & Roles page
/// (an ID document, a signed contract, etc.) — separate from Document
/// above, which is the Phase 6 receipt/bill OCR pipeline. Same
/// no-object-storage-yet situation as User.avatarUrl/Company.logoUrl
/// (see src/lib/branding.ts): the bytes live as a `data:` URL directly in
/// this row rather than a storageKey pointing at a bucket, so
/// src/lib/memberFiles.ts caps how big one of these can be. Revisit this
/// model (add a real storageKey) if that cap ever turns out too small —
/// don't just raise the cap on the base64-in-Postgres version.
model MemberFile {
  id           String   @id @default(cuid())
  companyId    String
  membershipId String
  title        String
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String
  uploadedBy   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([companyId, membershipId])
}

/// Optional per-user, per-module exceptions to the role's default permission
/// matrix (e.g. an Accountant granted EXPORT on Reports). The default matrix
/// itself is defined in code (/src/lib/rbac.ts) so it ships with tests.
model PermissionOverride {
  id           String           @id @default(cuid())
  membershipId String
  module       String // e.g. "reports", "journals", "bills"
  action       PermissionAction
  granted      Boolean

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, module, action])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id        String           @id @default(cuid())
  companyId String
  email     String
  role      CompanyRole
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, email])
}

// ─────────────────────────────────────────────────────────────────────────
// ACCOUNTING CORE (schema in place for Phase 2; posting engine not yet built)
// ─────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum SystemAccountPurpose {
  BANK
  ACCOUNTS_RECEIVABLE
  INPUT_TAX_RECEIVABLE
  ACCOUNTS_PAYABLE
  OUTPUT_TAX_PAYABLE
  EXCHANGE_GAIN_LOSS
  INVENTORY_ASSET
  COGS_EXPENSE
  GOODS_RECEIVED_NOT_INVOICED
}

model Account {
  id        String                @id @default(cuid())
  companyId String
  code      String
  name      String
  type      AccountType
  parentId  String?
  isSystem  Boolean               @default(false) // system accounts can't be deleted (e.g. AR, AP, VAT control)
  /// Which well-known role this system account fills, if any (set once at
  /// onboarding, immutable like code/type on a system account — see
  /// updateAccount in src/lib/accounts.ts). Lets the posting/reporting code
  /// resolve "this company's Bank account" via getBankAccountCode() instead
  /// of assuming the literal code "1000", which only holds for companies
  /// onboarded after this field existed.
  purpose   SystemAccountPurpose?
  isActive  Boolean               @default(true)
  currency  String? // null = base currency
  createdAt DateTime              @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, purpose])
}

enum PeriodStatus {
  OPEN
  CLOSING
  LOCKED
}

model AccountingPeriod {
  id        String       @id @default(cuid())
  companyId String
  name      String // e.g. "2026-09"
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus @default(OPEN)
  lockedAt  DateTime?
  lockedBy  String?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([companyId, name])
}

enum JournalSourceType {
  MANUAL
  INVOICE
  BILL
  PAYMENT
  RECEIPT
  EXPENSE
  BANK_IMPORT
  REVERSAL
  ADJUSTMENT
  RECURRING
  AI_DRAFT
  SHIPMENT
  PURCHASE_RECEIVE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Immutable once POSTED. Corrections are new REVERSAL/ADJUSTMENT entries
/// that reference reversalOfId — rows are never deleted or mutated post-post.
/// Enforcement lives in /src/lib/ledger.ts (server-only posting service),
/// never in the client.
model JournalEntry {
  id           String            @id @default(cuid())
  companyId    String
  periodId     String
  entryNumber  String // sequential, per-company, gapless for POSTED entries
  date         DateTime
  sourceType   JournalSourceType
  sourceId     String? // id of the Invoice/Bill/Payment/etc. that generated this
  memo         String?
  status       JournalStatus     @default(DRAFT)
  reversalOfId String?
  currency     String
  exchangeRate Decimal           @default(1) @db.Decimal(18, 8)
  postedAt     DateTime?
  postedBy     String?
  createdBy    String
  createdAt    DateTime          @default(now())

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      AccountingPeriod @relation(fields: [periodId], references: [id])
  reversalOf  JournalEntry?    @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals   JournalEntry[]   @relation("Reversal")
  lines       JournalLine[]
  creditNotes CreditNote[]

  @@unique([companyId, entryNumber])
  // Idempotency guard: prevents the race condition where two concurrent
  // requests for the same source document (e.g. a webhook firing twice, or
  // a user double-clicking "Post") both pass the app-level findFirst() check
  // before either has written, producing two journal entries for one source.
  // sourceId is nullable (MANUAL entries have none), so the constraint is
  // conditional: Postgres partial-unique index semantics (sourceId IS NOT NULL).
  // Prisma maps @@unique with a nullable field to a partial unique index in the
  // generated migration, which behaves correctly.
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId, periodId, status])
  // The reporting engine's real hot path (trial balance, P&L, balance
  // sheet, general ledger — src/lib/reports.ts) always filters
  // POSTED entries within a date range for one company; the
  // (companyId, periodId, status) index above doesn't help a date-range
  // scan, so this covers that query shape directly.
  @@index([companyId, status, date])
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)
  costCentreId   String?
  departmentId   String?
  projectId      String?
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  costCentre   CostCentre?  @relation(fields: [costCentreId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────
// PARTIES
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  email            String?
  phone            String?
  taxRegNumber     String?
  currency         String?
  paymentTermsDays Int      @default(30)
  isActive         Boolean  @default(true)
  /// Values for the company's custom fields, keyed by field key.
  customFields     Json?
  /// Secure token for the self-service customer portal URL (/portal/[token]).
  /// Minted on first portal access; rotatable by the company.
  portalToken      String?  @unique
  createdAt        DateTime @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  // CRM back-relations
  crmContacts       CrmContact[]
  convertedLeads    Lead[]
  deals             Deal[]
  crmActivities     CrmActivity[]
  quotes            Quote[]
  creditNotes       CreditNote[]
  recurringInvoices RecurringInvoice[]
  salesOrders       SalesOrder[]

  @@index([companyId])
}

model Supplier {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  email            String?
  phone            String?
  taxRegNumber     String?
  currency         String?
  paymentTermsDays Int      @default(30)
  isActive         Boolean  @default(true)
  /// Values for the company's custom fields, keyed by field key.
  customFields     Json?
  createdAt        DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bills          Bill[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  customerId     String
  projectId      String?
  invoiceNumber  String
  issueDate      DateTime
  dueDate        DateTime
  currency       String
  /// Rate to convert 1 unit of `currency` into the company's base currency,
  /// captured at issue time. Always 1 for a base-currency invoice. Every
  /// amount below (subtotal/taxTotal/total) is in `currency`; the ledger
  /// posting converts to base currency using this rate — see
  /// postInvoiceToLedger() in src/lib/sales.ts.
  exchangeRate   Decimal       @default(1) @db.Decimal(18, 8)
  subtotal       Decimal       @db.Decimal(18, 2)
  taxTotal       Decimal       @db.Decimal(18, 2)
  total          Decimal       @db.Decimal(18, 2)
  status         InvoiceStatus @default(DRAFT)
  journalEntryId String?
  /// Unguessable token for the public /pay/<token> page (created on first "Get payment link").
  payToken       String?       @unique
  /// Values for the company's custom invoice fields, keyed by field key.
  customFields   Json?
  /// Fingerprint of the spreadsheet row this invoice was imported from (Import past data) — stops double imports.
  importRef      String?
  createdAt      DateTime      @default(now())

  /// FK to the recurring template that generated this invoice (null for manual invoices).
  recurringInvoiceId String?
  /// Set when this invoice was raised from a Sales Order's shipped-not-yet-
  /// invoiced quantities (see createInvoiceFromSalesOrder in
  /// src/lib/sales-orders.ts). When set, postInvoiceToLedger() in
  /// src/lib/sales.ts posts Revenue/AR/Tax only — COGS was already posted
  /// at Shipment time, not here, so it's never posted twice.
  salesOrderId       String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  lines            InvoiceLine[]
  onlinePayments   OnlinePayment[]
  deal             Deal? // set when this invoice was created by closing a CRM deal
  quote            Quote? // set when this invoice was converted from a quote
  creditNotes      CreditNote[]
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])
  salesOrder       SalesOrder?       @relation(fields: [salesOrderId], references: [id])

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, importRef])
  @@index([companyId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String? // optional link to Product; enables inventory deduction on posting
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxCodeId   String?
  lineTotal   Decimal @db.Decimal(18, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxCode TaxCode? @relation(fields: [taxCodeId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

enum BillStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model Bill {
  id             String     @id @default(cuid())
  companyId      String
  supplierId     String
  projectId      String?
  billNumber     String
  issueDate      DateTime
  dueDate        DateTime
  currency       String
  exchangeRate   Decimal    @default(1) @db.Decimal(18, 8)
  subtotal       Decimal    @db.Decimal(18, 2)
  taxTotal       Decimal    @db.Decimal(18, 2)
  total          Decimal    @db.Decimal(18, 2)
  status         BillStatus @default(DRAFT)
  journalEntryId String?
  /// Fingerprint of the spreadsheet row this bill was imported from — stops double imports.
  importRef      String?
  createdAt      DateTime   @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  project       Project?       @relation(fields: [projectId], references: [id])
  lines         BillLine[]
  purchaseOrder PurchaseOrder? // set when bill was created from a PO

  @@unique([companyId, billNumber])
  @@unique([companyId, importRef])
  @@index([companyId, status])
}

model BillLine {
  id                  String  @id @default(cuid())
  billId              String
  productId           String? // optional link to Product; enables inventory receipt on bill approval
  /// Set when the line was raised from a Purchase Order. A tracked line
  /// linked this way was already capitalized by a PurchaseReceive, so bill
  /// approval clears GRNI rather than receiving stock again.
  purchaseOrderLineId String?
  description         String
  quantity            Decimal @db.Decimal(18, 4)
  unitPrice           Decimal @db.Decimal(18, 4)
  taxCodeId           String?
  lineTotal           Decimal @db.Decimal(18, 2)

  bill              Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  taxCode           TaxCode?           @relation(fields: [taxCodeId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([purchaseOrderLineId])
}

// ─────────────────────────────────────────────────────────────────────────
// BANKING
// ─────────────────────────────────────────────────────────────────────────

model BankAccount {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  accountNumber  String? // last 4 only should be shown in UI
  currency       String
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]
  reconciliations BankReconciliation[]

  @@index([companyId])
}

enum BankTxStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  IGNORED
}

model BankTransaction {
  id                    String       @id @default(cuid())
  bankAccountId         String
  date                  DateTime
  description           String
  amount                Decimal      @db.Decimal(18, 2) // signed: +in / -out
  status                BankTxStatus @default(UNMATCHED)
  matchedJournalEntryId String?
  importBatchId         String?
  reconciliationId      String? // set when included in a COMPLETED reconciliation
  createdAt             DateTime     @default(now())

  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliation BankReconciliation? @relation(fields: [reconciliationId], references: [id])

  @@index([bankAccountId, status])
  @@index([reconciliationId])
}

// ─────────────────────────────────────────────────────────────────────────
// BANK RECONCILIATION
// A BankReconciliation captures a statement period (openingBalance →
// closingBalance). Transactions are linked via BankTransaction.reconciliationId
// when the user ticks them as cleared. Finalising locks the reconciliation
// and flips the linked transactions to RECONCILED status.
// ─────────────────────────────────────────────────────────────────────────

enum ReconciliationStatus {
  DRAFT // in progress — can still add/remove transactions
  COMPLETED // locked; all linked transactions are RECONCILED
}

model BankReconciliation {
  id             String               @id @default(cuid())
  companyId      String
  bankAccountId  String
  statementDate  DateTime             @db.Date
  openingBalance Decimal              @db.Decimal(18, 2)
  closingBalance Decimal              @db.Decimal(18, 2)
  status         ReconciliationStatus @default(DRAFT)
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([companyId, bankAccountId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// TAX ENGINE (country-agnostic; UAE pack seeded first)
// ─────────────────────────────────────────────────────────────────────────

enum TaxTreatment {
  STANDARD
  ZERO_RATED
  EXEMPT
  OUT_OF_SCOPE
}

model TaxCode {
  id          String       @id @default(cuid())
  companyId   String
  countryCode String
  code        String // e.g. "VAT_STD_5"
  name        String
  rate        Decimal      @db.Decimal(6, 4) // e.g. 0.0500 for 5%
  treatment   TaxTreatment @default(STANDARD)
  isInput     Boolean // true = input/purchase tax, false = output/sales tax
  isActive    Boolean      @default(true)

  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines       InvoiceLine[]
  billLines          BillLine[]
  recurringLines     RecurringInvoiceLine[]
  quoteLines         QuoteLine[]
  purchaseOrderLines PurchaseOrderLine[]
  creditNoteLines    CreditNoteLine[]
  products           Product[]
  salesOrderLines    SalesOrderLine[]

  @@unique([companyId, code])
}

// ─────────────────────────────────────────────────────────────────────────
// PRODUCTS / ITEMS CATALOG
// ─────────────────────────────────────────────────────────────────────────

enum ProductType {
  PRODUCT
  SERVICE
}

/// A reusable line-item template (product or service). Referenced by invoice
/// lines, bill lines, quote lines, and PO lines as an optional catalogue entry.
/// The catalog is company-scoped; no cross-tenant leakage.
model Product {
  id                 String      @id @default(cuid())
  companyId          String
  name               String
  description        String?
  sku                String? // stock keeping unit; optional, unique per company
  type               ProductType @default(PRODUCT)
  unitPrice          Decimal     @db.Decimal(18, 4)
  currency           String      @default("USD")
  unit               String? // e.g. "each", "kg", "hour", "month"
  /// Chart-of-accounts code for the revenue account (sales/invoices)
  incomeAccountCode  String?
  /// Chart-of-accounts code for the COGS/expense account (bills/purchases)
  expenseAccountCode String?
  taxCodeId          String? // default tax rate for this item
  /// When true, quantityOnHand is maintained and checked on sales
  trackInventory     Boolean     @default(false)
  quantityOnHand     Decimal     @default(0) @db.Decimal(18, 4)
  reorderPoint       Decimal?    @db.Decimal(18, 4)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxCode            TaxCode?            @relation(fields: [taxCodeId], references: [id])
  stockMovements     StockMovement[]
  invoiceLines       InvoiceLine[]
  billLines          BillLine[]
  salesOrderLines    SalesOrderLine[]
  quoteLines         QuoteLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────
// INVENTORY — Stock Movement log
// Every change to quantityOnHand is recorded here (purchase receipts,
// sale shipments, manual adjustments, write-offs). quantityOnHand on
// Product is the running balance; StockMovement is the immutable audit log.
//
// referenceType / referenceId: loosely typed foreign key to the source
// document (e.g. "InvoiceLine", "BillLine", "StockAdjustment").
// ─────────────────────────────────────────────────────────────────────────

enum StockMovementType {
  RECEIPT // goods received (purchase / GRN)
  SHIPMENT // goods shipped (sale)
  ADJUSTMENT // manual stock count / write-off
  OPENING // opening stock balance entry
  RETURN_IN // customer return
  RETURN_OUT // supplier return
}

model StockMovement {
  id                 String            @id @default(cuid())
  companyId          String
  productId          String
  type               StockMovementType
  quantity           Decimal           @db.Decimal(18, 4) // positive = IN, negative = OUT
  balanceAfter       Decimal           @db.Decimal(18, 4) // snapshot of quantityOnHand after this movement
  unitCost           Decimal?          @db.Decimal(18, 4) // cost per unit at time of movement
  /// FIFO cost-layer bookkeeping: for an inbound movement (RECEIPT, OPENING,
  /// RETURN_IN) this is how much of that layer's quantity hasn't yet been
  /// consumed by a later outbound movement — set to `quantity` at creation
  /// and decremented as shipStock() consumes the oldest layers first. NULL
  /// (and unused) for an outbound movement (SHIPMENT, ADJUSTMENT, RETURN_OUT).
  costLayerRemaining Decimal?          @db.Decimal(18, 4)
  notes              String?
  referenceType      String? // "InvoiceLine" | "BillLine" | "StockAdjustment" | etc.
  referenceId        String?
  date               DateTime          @db.Date
  createdAt          DateTime          @default(now())
  createdBy          String // userId

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, date])
  @@index([referenceType, referenceId])
}

// ─────────────────────────────────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  code       String
  customerId String?
  budget     Decimal? @db.Decimal(18, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  bills          Bill[]
  timeEntries    TimeEntry[]
  quotes         Quote[]
  purchaseOrders PurchaseOrder[]
  journalLines   JournalLine[]
  salesOrders    SalesOrder[]

  @@unique([companyId, code])
}

// ─────────────────────────────────────────────────────────────────────────
// TIME TRACKING
// TimeEntry records hours worked against a project. isBillable entries can
// be converted to invoice lines via the "Invoice time" workflow.
// invoiceLineId is set (and isBillable is effectively locked) when the
// entry has been included in an invoice line — re-invoicing is prevented
// by the UI checking this field.
// ─────────────────────────────────────────────────────────────────────────

model TimeEntry {
  id            String   @id @default(cuid())
  companyId     String
  projectId     String
  userId        String // membership who logged the time
  date          DateTime @db.Date
  hours         Decimal  @db.Decimal(8, 2)
  description   String
  hourlyRate    Decimal? @db.Decimal(18, 2) // null → unbilled or use default
  isBillable    Boolean  @default(true)
  invoiceLineId String? // set once invoiced
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId])
  @@index([companyId, userId])
  @@index([invoiceLineId])
}

// ─────────────────────────────────────────────────────────────────────────
// CRM — Leads, Contacts, Deals, Pipelines, Activities (P1)
// Wires into accounting via Deal.invoiceId → Invoice.
// ─────────────────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum ActivityStatus {
  PLANNED
  DONE
  CANCELLED
}

model Pipeline {
  id        String   @id @default(cuid())
  companyId String
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stages  PipelineStage[]
  deals   Deal[]

  @@unique([companyId, name])
  @@index([companyId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  companyId   String
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(50)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, name])
  @@unique([pipelineId, position])
  @@index([companyId])
}

model Lead {
  id                  String     @id @default(cuid())
  companyId           String
  firstName           String
  lastName            String
  email               String?
  phone               String?
  companyName         String?
  jobTitle            String?
  source              String?
  status              LeadStatus @default(NEW)
  notes               String?
  assignedToId        String?
  createdById         String?
  convertedAt         DateTime?
  convertedCustomerId String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo        CompanyMembership? @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy         CompanyMembership? @relation("LeadCreatedBy", fields: [createdById], references: [id])
  convertedCustomer Customer?          @relation(fields: [convertedCustomerId], references: [id])
  activities        CrmActivity[]

  @@index([companyId, status])
  @@index([companyId, assignedToId])
  @@index([companyId, convertedCustomerId])
}

model CrmContact {
  id         String   @id @default(cuid())
  companyId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  department String?
  isPrimary  Boolean  @default(false)
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer?     @relation(fields: [customerId], references: [id])
  deals      Deal[]
  activities CrmActivity[]

  @@index([companyId])
  @@index([companyId, customerId])
}

model Deal {
  id                String    @id @default(cuid())
  companyId         String
  name              String
  value             Decimal   @db.Decimal(18, 4)
  currency          String    @default("USD")
  pipelineId        String
  stageId           String
  customerId        String?
  contactId         String?
  assignedToId      String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedWon         Boolean?
  lostReason        String?
  notes             String?
  invoiceId         String?   @unique
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pipeline   Pipeline           @relation(fields: [pipelineId], references: [id])
  stage      PipelineStage      @relation(fields: [stageId], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  contact    CrmContact?        @relation(fields: [contactId], references: [id])
  assignedTo CompanyMembership? @relation("DealAssignedTo", fields: [assignedToId], references: [id])
  invoice    Invoice?           @relation(fields: [invoiceId], references: [id])
  activities CrmActivity[]
  quotes     Quote[]

  @@index([companyId, pipelineId])
  @@index([companyId, stageId])
  @@index([companyId, assignedToId])
  @@index([companyId, closedWon])
}

model CrmActivity {
  id           String         @id @default(cuid())
  companyId    String
  type         ActivityType
  status       ActivityStatus @default(PLANNED)
  subject      String
  notes        String?
  dueAt        DateTime?
  doneAt       DateTime?
  leadId       String?
  dealId       String?
  contactId    String?
  customerId   String?
  assignedToId String?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead?              @relation(fields: [leadId], references: [id])
  deal       Deal?              @relation(fields: [dealId], references: [id])
  contact    CrmContact?        @relation(fields: [contactId], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  assignedTo CompanyMembership? @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  createdBy  CompanyMembership? @relation("ActivityCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, leadId])
  @@index([companyId, dealId])
  @@index([companyId, assignedToId])
  @@index([companyId, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────
// QUOTES / PURCHASE ORDERS / CREDIT NOTES (P1)
// ─────────────────────────────────────────────────────────────────────────

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  INVOICED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  BILLED
  CANCELLED
}

enum CreditNoteStatus {
  DRAFT
  POSTED
  APPLIED
  VOID
}

model Quote {
  id           String      @id @default(cuid())
  companyId    String
  customerId   String
  dealId       String?
  projectId    String?
  quoteNumber  String
  issueDate    DateTime
  expiryDate   DateTime?
  currency     String      @default("USD")
  subtotal     Decimal     @db.Decimal(18, 2)
  taxTotal     Decimal     @db.Decimal(18, 2)
  total        Decimal     @db.Decimal(18, 2)
  status       QuoteStatus @default(DRAFT)
  notes        String?
  customFields Json?
  invoiceId    String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id])
  deal       Deal?       @relation(fields: [dealId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  lines      QuoteLine[]
  salesOrder SalesOrder?

  @@unique([companyId, quoteNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String?
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxCodeId   String?
  lineTotal   Decimal @db.Decimal(18, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxCode TaxCode? @relation(fields: [taxCodeId], references: [id])

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// SALES ORDERS + SHIPMENTS
// The workflow stage between a Quote/direct order and an Invoice: a Sales
// Order commits to selling specific quantities; a Shipment records goods
// physically going out against it (partial shipments supported — a line's
// shippedQuantity accumulates across multiple Shipments); an Invoice is
// then raised against what's been shipped but not yet invoiced.
//
// Cost recognition happens at SHIPMENT time (see createShipment in
// src/lib/sales-orders.ts), not at invoice time — this mirrors Zoho Books:
// the moment goods leave the warehouse is when COGS is real, whether or
// not the customer has been billed yet. An Invoice raised from a Sales
// Order (Invoice.salesOrderId set) therefore posts Revenue/AR/Tax only;
// postInvoiceToLedger's own ship+COGS step (for a direct, order-less
// invoice) is skipped entirely for one, so cost is never posted twice.
// ─────────────────────────────────────────────────────────────────────────

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_SHIPPED
  SHIPPED
  INVOICED
  CANCELLED
}

model SalesOrder {
  id          String           @id @default(cuid())
  companyId   String
  customerId  String
  quoteId     String?          @unique
  projectId   String?
  orderNumber String
  issueDate   DateTime
  currency    String           @default("USD")
  subtotal    Decimal          @db.Decimal(18, 2)
  taxTotal    Decimal          @db.Decimal(18, 2)
  total       Decimal          @db.Decimal(18, 2)
  status      SalesOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer         @relation(fields: [customerId], references: [id])
  quote     Quote?           @relation(fields: [quoteId], references: [id])
  project   Project?         @relation(fields: [projectId], references: [id])
  lines     SalesOrderLine[]
  shipments Shipment[]
  invoices  Invoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model SalesOrderLine {
  id               String  @id @default(cuid())
  salesOrderId     String
  productId        String?
  description      String
  quantity         Decimal @db.Decimal(18, 4)
  unitPrice        Decimal @db.Decimal(18, 4)
  taxCodeId        String?
  lineTotal        Decimal @db.Decimal(18, 2)
  /// Cumulative quantity shipped against this line across all Shipments —
  /// never exceeds `quantity`. See createShipment in src/lib/sales-orders.ts.
  shippedQuantity  Decimal @default(0) @db.Decimal(18, 4)
  /// Cumulative quantity invoiced against this line — never exceeds
  /// shippedQuantity (you can't invoice what hasn't shipped).
  invoicedQuantity Decimal @default(0) @db.Decimal(18, 4)

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxCode       TaxCode?       @relation(fields: [taxCodeId], references: [id])
  shipmentLines ShipmentLine[]

  @@index([productId])
}

model Shipment {
  id             String   @id @default(cuid())
  companyId      String
  salesOrderId   String
  shipmentNumber String
  shipDate       DateTime @db.Date
  notes          String?
  createdAt      DateTime @default(now())
  createdBy      String // userId

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id])
  lines      ShipmentLine[]

  @@unique([companyId, shipmentNumber])
  @@index([companyId, salesOrderId])
}

model ShipmentLine {
  id               String  @id @default(cuid())
  shipmentId       String
  salesOrderLineId String
  quantity         Decimal @db.Decimal(18, 4)

  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])

  @@index([salesOrderLineId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  companyId    String
  supplierId   String
  projectId    String?
  poNumber     String
  issueDate    DateTime
  expectedDate DateTime?
  currency     String              @default("USD")
  /// Rate to convert 1 unit of `currency` into the company's base currency,
  /// captured when the PO is raised. Purchase receives value stock at
  /// unitPrice x this rate (see createPurchaseReceive).
  exchangeRate Decimal             @default(1) @db.Decimal(18, 8)
  subtotal     Decimal             @db.Decimal(18, 2)
  taxTotal     Decimal             @db.Decimal(18, 2)
  total        Decimal             @db.Decimal(18, 2)
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  billId       String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  project  Project?            @relation(fields: [projectId], references: [id])
  bill     Bill?               @relation(fields: [billId], references: [id])
  lines    PurchaseOrderLine[]
  receives PurchaseReceive[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, supplierId])
}

model PurchaseOrderLine {
  id               String  @id @default(cuid())
  poId             String
  productId        String?
  description      String
  quantity         Decimal @db.Decimal(18, 4)
  unitPrice        Decimal @db.Decimal(18, 4)
  taxCodeId        String?
  lineTotal        Decimal @db.Decimal(18, 2)
  /// Cumulative quantity received against this line across all
  /// PurchaseReceives — never exceeds `quantity`.
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4)
  /// Cumulative quantity billed against this line (bills in any status but
  /// VOID). A tracked-inventory line can only be billed up to what has been
  /// received; any other line up to `quantity`. See convertPOToBill.
  billedQuantity   Decimal @default(0) @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder         @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  taxCode       TaxCode?              @relation(fields: [taxCodeId], references: [id])
  receiveLines  PurchaseReceiveLine[]
  billLines     BillLine[]

  @@index([productId])
}

/// A goods receipt against a Purchase Order. For tracked-inventory lines it
/// posts DR Inventory Asset / CR Goods Received Not Invoiced at the PO's
/// base-currency cost and creates the FIFO cost layer; the eventual Bill
/// then clears GRNI instead of debiting Inventory Asset a second time. See
/// src/lib/purchase-orders.ts.
model PurchaseReceive {
  id            String   @id @default(cuid())
  companyId     String
  poId          String
  receiveNumber String
  receiveDate   DateTime @db.Date
  notes         String?
  createdAt     DateTime @default(now())
  createdBy     String // userId

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder         @relation(fields: [poId], references: [id])
  lines         PurchaseReceiveLine[]

  @@unique([companyId, receiveNumber])
  @@index([companyId, poId])
}

model PurchaseReceiveLine {
  id                  String  @id @default(cuid())
  receiveId           String
  purchaseOrderLineId String
  quantity            Decimal @db.Decimal(18, 4)
  /// Base-currency unit cost the stock was capitalized at.
  unitCost            Decimal @db.Decimal(18, 4)

  receive           PurchaseReceive   @relation(fields: [receiveId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([purchaseOrderLineId])
}

model CreditNote {
  id             String           @id @default(cuid())
  companyId      String
  customerId     String
  invoiceId      String?
  creditNumber   String
  issueDate      DateTime
  currency       String
  exchangeRate   Decimal          @default(1) @db.Decimal(18, 8)
  subtotal       Decimal          @db.Decimal(18, 2)
  taxTotal       Decimal          @db.Decimal(18, 2)
  total          Decimal          @db.Decimal(18, 2)
  status         CreditNoteStatus @default(DRAFT)
  reason         String?
  journalEntryId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id])
  invoice      Invoice?         @relation(fields: [invoiceId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  lines        CreditNoteLine[]

  @@unique([companyId, creditNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model CreditNoteLine {
  id           String  @id @default(cuid())
  creditNoteId String
  description  String
  quantity     Decimal @db.Decimal(18, 4)
  unitPrice    Decimal @db.Decimal(18, 4)
  taxCodeId    String?
  lineTotal    Decimal @db.Decimal(18, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  taxCode    TaxCode?   @relation(fields: [taxCodeId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────
// RECURRING INVOICES / BUDGETS (P1)
// ─────────────────────────────────────────────────────────────────────────

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}

model RecurringInvoice {
  id                    String             @id @default(cuid())
  companyId             String
  customerId            String
  currency              String             @default("USD")
  frequency             RecurringFrequency
  startDate             DateTime
  endDate               DateTime?
  nextRunAt             DateTime
  lastRunAt             DateTime?
  status                RecurringStatus    @default(ACTIVE)
  notes                 String?
  /// The membership that created this schedule. The cron-driven scheduler
  /// (processRecurringInvoices) runs generation through this membership's
  /// own permissions rather than skipping RBAC — see src/lib/recurring-invoices.ts.
  /// Nullable only because rows created before this column existed have no
  /// value to backfill; the scheduler treats a null here as a pre-existing
  /// row and skips the permission check for it (logged, not fatal).
  createdByMembershipId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer               @relation(fields: [customerId], references: [id])
  createdBy CompanyMembership?     @relation(fields: [createdByMembershipId], references: [id])
  lines     RecurringInvoiceLine[]
  invoices  Invoice[]

  @@index([companyId])
  @@index([nextRunAt, status])
}

model RecurringInvoiceLine {
  id                 String  @id @default(cuid())
  recurringInvoiceId String
  description        String
  quantity           Decimal @db.Decimal(18, 4)
  unitPrice          Decimal @db.Decimal(18, 4)
  taxCodeId          String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  taxCode          TaxCode?         @relation(fields: [taxCodeId], references: [id])
}

model Budget {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  fiscalYear Int
  currency   String   @default("USD")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   BudgetItem[]

  @@unique([companyId, name, fiscalYear])
  @@index([companyId, fiscalYear])
}

model BudgetItem {
  id          String  @id @default(cuid())
  budgetId    String
  accountCode String
  month       Int
  amount      Decimal @db.Decimal(18, 2)

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, accountCode, month])
  @@index([budgetId, accountCode])
}

// ─────────────────────────────────────────────────────────────────────────
// DOCUMENTS (AI extraction pipeline target — Phase 6)
// ─────────────────────────────────────────────────────────────────────────

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  MATCHED
  DRAFTED
  LINKED
  IGNORED
  FAILED
}

/// EXPENSE is the original expense/bill-receipt pipeline (src/lib/ai/extraction.ts).
/// CUSTOMER_RECORD is Customer File Intelligence (src/lib/ai/customer-extraction.ts) —
/// same Document table, same dedupe-by-hash behavior, just a different
/// review queue and a different shape of extractedData.
enum DocumentKind {
  EXPENSE
  CUSTOMER_RECORD
}

model Document {
  id            String         @id @default(cuid())
  companyId     String
  fileName      String
  storageKey    String // object storage path — never a public URL
  hash          String // sha256, for duplicate detection
  mimeType      String
  sizeBytes     Int
  status        DocumentStatus @default(UPLOADED)
  kind          DocumentKind   @default(EXPENSE)
  extractedData Json?
  relatedEntity String? // e.g. "Bill:cuid..." or "Customer:cuid..."
  uploadedBy    String
  createdAt     DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, kind, status])
  @@index([hash])
}

// ─────────────────────────────────────────────────────────────────────────
// WORKFLOW / APPROVALS
// ─────────────────────────────────────────────────────────────────────────

model WorkflowRule {
  id           String      @id @default(cuid())
  companyId    String
  name         String
  entityType   String // "Expense" | "Bill" | "JournalEntry" ...
  minAmount    Decimal?    @db.Decimal(18, 2)
  maxAmount    Decimal?    @db.Decimal(18, 2)
  requiredRole CompanyRole
  isActive     Boolean     @default(true)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([companyId, entityType])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id             String         @id @default(cuid())
  workflowRuleId String
  entityType     String
  entityId       String
  status         ApprovalStatus @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  comment        String?
  createdAt      DateTime       @default(now())

  workflowRule WorkflowRule @relation(fields: [workflowRuleId], references: [id])
  decider      User?        @relation(fields: [decidedBy], references: [id])

  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────────────────

/// Append-only. No update/delete path exists anywhere in the app for this
/// model — /src/lib/audit.ts only ever calls create().
model AuditEvent {
  id            String   @id @default(cuid())
  companyId     String?
  userId        String?
  action        String // e.g. "journal.post", "invoice.void", "user.login"
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  source        String   @default("web") // web | api | ai | system
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([createdAt])
  // The Audit Log page (Phase 9) lists one company's events newest-first
  // with pagination — this composite covers that scan+sort directly,
  // where the standalone createdAt index above would still need to
  // filter companyId out of every partition.
  @@index([companyId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// SUBSCRIPTIONS (billing-provider-agnostic)
// ─────────────────────────────────────────────────────────────────────────

enum SubscriptionPlan {
  STARTER
  GROWTH
  PROFESSIONAL
  AI_CFO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String             @unique
  plan               SubscriptionPlan   @default(STARTER)
  status             SubscriptionStatus @default(TRIALING)
  provider           String? // "stripe" | null while unconfigured
  providerCustomerId String?
  currentPeriodEnd   DateTime?
  seats              Int                @default(1)
  createdAt          DateTime           @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiUsage AiUsageEvent[]
}

model AiUsageEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  kind           String // "copilot_query" | "ocr_page" | "forecast_run"
  units          Int      @default(1)
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, kind])
}

// ---------------------------------------------------------------------------
// Personalisation & customisation
// ---------------------------------------------------------------------------

/// Personal settings — they follow the user across every company they belong to.
model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  theme        String   @default("system") // system | light | dark
  density      String   @default("comfortable") // comfortable | compact
  landingPage  String   @default("/dashboard")
  dateFormat   String   @default("YYYY-MM-DD")
  numberFormat String   @default("1,234.56")
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A user's dashboard in one company: which cards, in which order, over which period.
model DashboardLayout {
  id           String   @id @default(cuid())
  membershipId String   @unique
  widgets      Json // [{ id: string, visible: boolean }] in display order
  range        String   @default("mtd") // mtd | qtd | ytd | last30
  updatedAt    DateTime @updatedAt

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

enum CustomFieldEntity {
  CUSTOMER
  SUPPLIER
  INVOICE
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

/// Admin-defined extra fields on customers, suppliers and invoices.
model CustomFieldDefinition {
  id        String            @id @default(cuid())
  companyId String
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType
  options   String[]
  required  Boolean           @default(false)
  position  Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entity, key])
  @@index([companyId, entity])
}

// ---------------------------------------------------------------------------
// Online invoice payments (Stripe Connect)
// ---------------------------------------------------------------------------

/// A company's own Stripe account, connected through Stripe Connect so its
/// customers' invoice payments settle straight to that company — Finloraq
/// never holds their money.
model PaymentConnection {
  id                      String   @id @default(cuid())
  companyId               String   @unique
  provider                String   @default("stripe")
  accountId               String   @unique
  chargesEnabled          Boolean  @default(false)
  payoutsEnabled          Boolean  @default(false)
  detailsSubmitted        Boolean  @default(false)
  /// The admin who connected the account; webhook-driven postings are made
  /// under this membership so they go through the normal RBAC + ledger path.
  connectedByMembershipId String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum OnlinePaymentStatus {
  POSTED
  NEEDS_REVIEW
}

/// One successful online payment of an invoice. The unique provider id makes
/// webhook retries harmless.
model OnlinePayment {
  id                String              @id @default(cuid())
  companyId         String
  invoiceId         String
  provider          String              @default("stripe")
  providerPaymentId String              @unique
  checkoutSessionId String?
  amount            Decimal             @db.Decimal(18, 2)
  currency          String
  status            OnlinePaymentStatus
  journalEntryId    String?
  note              String?
  createdAt         DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([invoiceId])
}

/// One row per request counted by the rate limiter (src/lib/rateLimit.ts).
/// Shared by every server instance, so limits hold across serverless
/// instances. `keyHash` is a SHA-256 of the limiter key (keys can contain an
/// email address), never the key itself. Rows older than the longest window
/// are pruned by the limiter.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  keyHash   String   @db.Char(64)
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// PUBLIC API KEYS (/api/v1) — see src/lib/apiKeys.ts
// ─────────────────────────────────────────────────────────────────────────

/// A company-scoped key for the public REST API. Only a SHA-256 hash of the
/// key is stored; the raw key is shown once, at creation. A key acts as the
/// member who created it, capped by its own `role`: every request is allowed
/// only if BOTH that member (live role + overrides) and `role` permit it.
model ApiKey {
  id           String      @id @default(cuid())
  companyId    String
  membershipId String
  label        String
  role         CompanyRole
  /// First characters of the key, shown in the UI so a key can be recognized.
  prefix       String
  keyHash      String      @unique
  createdBy    String
  createdAt    DateTime    @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  revokedBy    String?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
